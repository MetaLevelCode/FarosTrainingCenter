rules_version = '2';

// ============================================================
// FAROS Training Center — Firestore Security Rules
//
// Assumed Data Model
// ──────────────────
// usuarios/{uid}
//   nombres: string, apellidos: string, cedula: string,
//   email: string, rol: 'admin'|'profesor'|'estudiante',
//   activo: bool (optional), estadisticas: map (optional),
//   suscripcionActiva: map|null (optional, LEGACY — un solo plan, en
//     transición hacia suscripcionesActivas, ver abajo)
//   suscripcionesActivas: map<suscripcionId, map> (optional) — permite
//     varios planes concurrentes (ej. natación personalizada + actividad
//     física a la vez), indexado por suscripcionId para poder actualizar
//     una sola entrada por dot-path sin tocar las demás.
//
// perfiles_publicos/{uid}  — read: true (público, sin login); write: false
//   Subconjunto público de un profesor (usuarios/{uid}): nombres,
//   apellidos, rol. Sin PII (nada de cédula/teléfono/email/EPS/
//   dificultades/disponibilidad). Alimenta el wizard de inscripción
//   abierto a invitados (/dashboard/planes). Sincronizado exclusivamente
//   por Admin SDK en POST /api/admin/usuarios/[uid]/rol al promover o
//   quitar el rol 'profesor' — nunca por el cliente.
//
// catalogo/{codigo}  — read: any auth; write: admin only
//
// planes/{planId}    — read: any auth; write: admin only
//
// suscripciones/{id}
//   usuarioId: string, planId: string, estado: string ...
//
// transacciones/{id}
//   usuarioId: string, planId: string, estado: string, monto: number ...
//
// clases/{id}
//   instructor_id: string, estudiantes_inscritos: [uid], plan: string[] ...
//
// solicitudes_personalizadas/{id}  — clases personalizadas (1-a-1 etc.)
//   alumnoId: string, profesorId: string, dow: number,
//   horaInicio/horaFin: string, estado: string ...
//
// rutinas_virtuales/{id}  — Plan Virtual: rutina remota, sin clases/sede
//   alumnoId: string, profesorId: string, nombre: string, estado: string ...
//   rutinas_virtuales/{id}/sesiones/{id}
//     titulo, descripcion, videoUrl, orden, completada: bool, completadaEn
//
// asistencias/{id}
//   claseId: string, usuarioId: string, registradoPor: string, asistio: bool
//
// movimientos/{id}   — write: admin only (or via approved transaction)
//
// categorias/{id}    — read: any auth; write: admin only
//
// sugerencias/{id}   — write: owner; read: admin o el dueño (uid)
//
// cancelaciones/{id}  — write: Admin SDK only
//   usuarioId: string, claseId: string, fecha_hora_clase: number, canceladoEn: number
//
// mensajes/{canalId}  — doc de control (Admin SDK only): participantes: [uid]
//   mensajes/{canalId}/items/{id}
//     autorId: string, autorNombre: string, autorRol: 'alumno'|'entrenador',
//     texto: string, ts: number
//
// notificaciones/{id}  — avisos por acciones que afectan a otro usuario
//   destinatarioId: string|null (uno de los dos), paraRol: 'admin'|null,
//   tipo: string (enum), titulo: string, mensaje: string, enlace: string|null,
//   actorId: string, leida: bool, creadoEn: number
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Usuarios con activo == false quedan suspendidos y pierden todos los permisos
    // basados en rol. isOwner() no llama activoOk() para que puedan leer su propio perfil.
    function activoOk() {
      return isAuthenticated() && getUsuario().get('activo', true) != false;
    }

    function miRol() {
      return isAuthenticated() ? getUsuario().rol : '';
    }

    function isAdmin() {
      return activoOk() && miRol() == 'admin';
    }

    function isProfesor() {
      return activoOk() && miRol() == 'profesor';
    }

    function isEstudiante() {
      return activoOk() && miRol() == 'estudiante';
    }

    function isAdminOrProfesor() {
      return isAdmin() || isProfesor();
    }

    function validString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // ── usuarios ────────────────────────────────────────────

    match /usuarios/{uid} {
      // El documento completo (cédula, teléfono, EPS, dificultades, etc.)
      // solo lo lee su dueño, un admin o un profesor — nunca es público.
      // La lectura pública de "nombre de un profesor" para el wizard sin
      // login vive en `perfiles_publicos/{uid}` (subconjunto sin PII),
      // no acá.
      allow read: if isOwner(uid) || isAdmin() || isProfesor();

      // Lista blanca explícita: impide que el estudiante se auto-asigne
      // suscripcionActiva, estadisticas u otros campos sensibles al registrarse.
      allow create: if isOwner(uid)
        && request.resource.data.rol == 'estudiante'
        && request.resource.data.keys().hasOnly([
             'nombres', 'apellidos', 'cedula', 'email', 'rol',
             'telefono', 'telefonoEmergencia', 'eps', 'sede',
             'dificultades', 'fecha_registro'
           ])
        && validString('nombres', 100)
        && validString('apellidos', 100)
        && validString('email', 200);

      allow update: if (isAdmin()
            // rol queda excluido acá a propósito: el único lugar donde debe
            // poder cambiar es POST /api/admin/usuarios/[uid]/rol (Admin
            // SDK), que sincroniza perfiles_publicos/{uid} en el mismo
            // batch — un updateDoc() directo del cliente saltaría ese sync.
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']))
        // estadisticas queda fuera de lo que el dueño puede tocar: se
        // escribe solo server-side (Admin SDK en inscribir/cancelar, ver
        // esos endpoints) o por el profesor vía la rama de abajo — nunca
        // por el propio alumno, para que la racha cacheada sea confiable.
        // El profesor ya NO tiene una rama acá: registrarAsistencia()
        // (lib/firestore.ts) pasa por POST /api/clases/[claseId]/asistencia
        // (Admin SDK), que sí puede validar que sea instructor de ESA clase
        // puntual y que el alumno esté inscrito en ella antes de tocar
        // estadisticas — algo que esta regla, evaluando el doc de usuarios
        // de forma aislada, nunca pudo verificar.
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['rol', 'activo', 'suscripcionActiva', 'suscripcionesActivas', 'estadisticas'])
            && disponibilidadValida());

      allow delete: if isAdmin();
    }

    // Validación de forma de Usuario.disponibilidadPersonal (franjas para
    // clases personalizadas) — el profesor la edita directo desde el
    // cliente, así que solo se valida que sea una lista razonable; el
    // detalle de cada franja (dow/horaInicio/horaFin) lo valida la UI y,
    // de forma autoritativa, las API routes de /api/personalizadas/* que
    // la leen (un profesor mandando franjas mal formadas solo rompe su
    // propia UI, no escala privilegios).
    function disponibilidadValida() {
      let d = request.resource.data.get('disponibilidadPersonal', []);
      return d is list && d.size() <= 20;
    }

    // ── perfiles_publicos ───────────────────────────────────
    // Subconjunto público de un profesor, sin PII — ver nota de schema
    // arriba. Único propósito: listar entrenadores en el wizard de
    // inscripción antes de que el visitante inicie sesión. Se escribe
    // solo desde POST /api/admin/usuarios/[uid]/rol (Admin SDK) al
    // cambiar el rol de un usuario, nunca desde el cliente.

    match /perfiles_publicos/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ── catalogo ────────────────────────────────────────────

    match /catalogo/{codigo} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── planes ──────────────────────────────────────────────

    match /planes/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── sedes ───────────────────────────────────────────────

    match /sedes/{sedeId} {
      // Lectura pública a propósito: el wizard de planes dice estar
      // "abierto a invitados" — sin esto, un visitante sin cuenta caía
      // siempre al catálogo hardcodeado de fallback (ver 6.11 y 7 en
      // PLAN_DE_CIERRE.md). Es catálogo/precios, no datos sensibles.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── grupos (grupales con horario) ───────────────────────

    match /grupos/{grupoId} {
      // Lectura pública a propósito — ver nota en `sedes` arriba.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── tarifas ─────────────────────────────────────────────
    // Solo existe el doc 'actual' — matriz de precios que consume el wizard.

    match /tarifas/{docId} {
      // Lectura pública a propósito — ver nota en `sedes` arriba.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── suscripciones ────────────────────────────────────────

    match /suscripciones/{suscId} {
      allow read: if isAdmin() || isProfesor()
        || (isAuthenticated() && resource.data.usuarioId == request.auth.uid);

      allow write: if isAdmin();
    }

    // ── transacciones ────────────────────────────────────────

    match /transacciones/{txId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.usuarioId == request.auth.uid);

      // Creación solo vía POST /api/transacciones (Admin SDK, sin pasar por reglas).
      allow create: if false;

      // Admin puede actualizar cualquier campo (aprobar / rechazar).
      // El propio estudiante puede actualizar SOLO comprobante_url en su tx pendiente.
      allow update: if isAdmin()
        || (isEstudiante()
            && resource.data.usuarioId == request.auth.uid
            && resource.data.estado == 'pendiente'
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['comprobante_url']));
      allow delete: if isAdmin();
    }

    // ── solicitudes_personalizadas ──────────────────────────
    // Flujo de clases personalizadas (1-a-1/pareja/familia/reducido):
    // disponibilidad del profesor → solicitud del alumno → aceptar/
    // rechazar. Toda escritura mutante pasa por Admin SDK (rutas
    // /api/personalizadas/*) porque aceptar necesita re-validar
    // disponibilidad + chocar contra `clases` real de forma atómica,
    // algo que las reglas no pueden hacer — ni siquiera el dueño
    // escribe directo, a diferencia de `transacciones` (que sí deja
    // al estudiante tocar comprobante_url).

    match /solicitudes_personalizadas/{solId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.alumnoId == request.auth.uid)
        || (isAuthenticated() && resource.data.profesorId == request.auth.uid);

      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── grupos_personalizados ────────────────────────────────
    // Modalidades personales "por persona" (pareja/familia/reducido):
    // grupo compartido con código — ver comentario en lib/types.ts.
    // Toda escritura pasa por aprobarTransaccion() (client SDK del admin,
    // cumple isAdmin()) o por Admin SDK en /api/grupos-personalizados/unirse
    // (bypassea reglas) — mismo criterio que solicitudes_personalizadas.

    match /grupos_personalizados/{codigo} {
      allow read: if isAdmin() || isProfesor()
        || (isAuthenticated() && request.auth.uid in resource.data.miembrosIds);

      allow write: if isAdmin();
    }

    // ── clases ───────────────────────────────────────────────

    match /clases/{claseId} {
      allow read: if isAuthenticated();

      allow create, delete: if isAdmin();

      // Se agrega 'plan' a los campos que el instructor puede modificar
      // para que el calendario del portal pueda guardar el plan de la clase.
      // La inscripción (estudiantes_inscritos) se gestiona vía Admin SDK en
      // POST /api/clases/[id]/inscribir y /cancelar — garantiza atomicidad de cupos.
      allow update: if isAdmin()
        || (isProfesor() && resource.data.instructor_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['observaciones_profesor', 'estado', 'actualizadoEn', 'plan']));
    }

    // ── asistencias ──────────────────────────────────────────

    match /asistencias/{asistId} {
      allow read: if isAdmin() || isProfesor()
        || (isAuthenticated() && resource.data.usuarioId == request.auth.uid);

      // El profesor ya no escribe acá desde el cliente: registrarAsistencia()
      // (lib/firestore.ts) pasa por POST /api/clases/[claseId]/asistencia
      // (Admin SDK), que valida instructor_id + estudiantes_inscritos antes
      // de tocar este doc y el de usuarios/{uid}.estadisticas en la misma
      // transacción — algo que esta regla, viendo solo `asistencias` de
      // forma aislada, nunca pudo validar (no chequeaba estudiantes_inscritos).
      allow create: if isAdmin();
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ── rutinas_virtuales ────────────────────────────────────
    // Plan Virtual: rutina remota armada por un profesor/admin para UN
    // alumno específico — sin clases/sede/horario. El alumno dueño solo
    // puede tocar completada/completadaEn de sus propias sesiones (mismo
    // patrón que ya usa `transacciones` para dejar tocar solo
    // comprobante_url); todo lo demás lo controla el profesor asignado
    // o un admin.

    function esDuenoRutina(rutinaId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/rutinas_virtuales/$(rutinaId)).data.alumnoId == request.auth.uid;
    }
    function esProfesorRutina(rutinaId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/rutinas_virtuales/$(rutinaId)).data.profesorId == request.auth.uid;
    }

    match /rutinas_virtuales/{rutinaId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.profesorId == request.auth.uid)
        || (isAuthenticated() && resource.data.alumnoId == request.auth.uid);

      // Se crea al aprobar la transacción del plan Virtual (Admin SDK,
      // ver aprobarTransaccion()) — un profesor también puede crear
      // rutinas para sus propios alumnos asignados directo desde el
      // cliente si hace falta gestionarlas fuera de ese flujo.
      allow create: if isAdminOrProfesor()
        && (isAdmin() || request.resource.data.profesorId == request.auth.uid)
        && request.resource.data.keys().hasOnly([
             'rutinaId', 'alumnoId', 'profesorId', 'nombre', 'estado', 'creadoEn', 'actualizadoEn',
             'nombre_alumno', 'nombre_profesor',
           ])
        && request.resource.data.estado in ['activa', 'archivada'];

      allow update: if isAdmin()
        || (isProfesor() && resource.data.profesorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'estado', 'actualizadoEn', 'nombre_alumno', 'nombre_profesor']));

      allow delete: if isAdmin();

      match /sesiones/{sesionId} {
        allow read: if isAdmin() || esProfesorRutina(rutinaId) || esDuenoRutina(rutinaId);

        // Contenido (título/descripción/video/orden): solo admin o el
        // profesor dueño de la rutina — nunca el alumno.
        allow create: if isAdminOrProfesor() && (isAdmin() || esProfesorRutina(rutinaId))
          && request.resource.data.keys().hasOnly([
               'sesionId', 'titulo', 'descripcion', 'videoUrl', 'orden',
               'completada', 'completadaEn', 'creadoEn', 'actualizadoEn',
             ])
          && request.resource.data.completada == false;

        allow update: if isAdmin()
          || (isProfesor() && esProfesorRutina(rutinaId)
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['completada', 'completadaEn']))
          || (isEstudiante() && esDuenoRutina(rutinaId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['completada', 'completadaEn']));

        allow delete: if isAdmin() || (isProfesor() && esProfesorRutina(rutinaId));
      }
    }

    // ── movimientos ──────────────────────────────────────────

    match /movimientos/{movId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── categorias ───────────────────────────────────────────

    match /categorias/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── cancelaciones ────────────────────────────────────────
    // Rastro de cancelaciones a tiempo — solo lo escribe Admin SDK desde
    // POST /api/clases/[claseId]/cancelar (ver 6.16 en PLAN_DE_CIERRE.md).
    // Se usa para el comodín de la Racha semanal (lib/racha.ts).

    match /cancelaciones/{id} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.usuarioId == request.auth.uid);
      allow write: if false;
    }

    // ── mensajes ─────────────────────────────────────────────
    // Fase 5. Dos tipos de canal, codificados en el propio canalId:
    //   grupo:<slug>      — muro persistente de un grupo (ej. "Knowill").
    //                       La membresía vive en el doc de control
    //                       mensajes/{canalId}.participantes, mantenida
    //                       SOLO por Admin SDK (/api/clases/[id]/inscribir
    //                       y /cancelar) — nunca por el cliente. Las
    //                       reglas no pueden "buscar todas las clases de
    //                       este grupo", así que se apoyan en esa lista
    //                       denormalizada (mismo precedente de get()
    //                       cross-doc que ya usa `asistencias` con `clases`).
    //   dm:<coachId>:<alumnoId> — chat privado; sin doc de control, la
    //                       membresía se parsea directo del canalId.

    function esMiembroCanalGrupo(canalId) {
      return exists(/databases/$(database)/documents/mensajes/$(canalId))
        && request.auth.uid in
           get(/databases/$(database)/documents/mensajes/$(canalId)).data.participantes;
    }

    function esMiembroCanalPrivado(canalId) {
      let partes = canalId.split(':');
      return request.auth.uid == partes[1] || request.auth.uid == partes[2];
    }

    function esMiembroCanal(canalId) {
      return isAuthenticated() && (
        (canalId.matches('grupo:.*') && esMiembroCanalGrupo(canalId)) ||
        (canalId.matches('dm:.*') && esMiembroCanalPrivado(canalId))
      );
    }

    match /mensajes/{canalId} {
      // Doc de control: nunca lo lee/escribe el cliente directo — solo
      // Admin SDK (mantiene `participantes`) y las reglas de arriba (get()).
      allow read, write: if false;

      match /items/{mensajeId} {
        allow read: if isAdmin() || esMiembroCanal(canalId);

        allow create: if (isAdmin() || esMiembroCanal(canalId))
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['autorId', 'autorNombre', 'autorRol', 'autorFoto', 'texto', 'ts'])
          && validString('texto', 2000);

        // v1: sin editar/borrar mensajes propios.
        allow update, delete: if isAdmin();
      }
    }

    // ── sugerencias ──────────────────────────────────────────

    match /sugerencias/{sugId} {
      allow read: if isAdmin() || isOwner(resource.data.uid);

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && validString('mensaje', 2000)
        && request.resource.data.leida == false
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'mensaje', 'createdAt', 'leida']);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── notificaciones ───────────────────────────────────────
    // Avisos por acciones que afectan a otro usuario. La mayoría se
    // escriben vía Admin SDK (aceptar/rechazar/solicitar/cancelar clase
    // personalizada — bypassea estas reglas igual que solicitudes_
    // personalizadas). Dos puntos SÍ escriben client-side y necesitan
    // reglas: el admin notifica al alumno puntual al aprobar su plan
    // (aprobarTransaccion, runTransaction del propio admin) y el
    // estudiante notifica "al grupo admin" (paraRol) al subir su
    // comprobante — nunca puede dirigirse a otro usuario específico,
    // así no puede hacerse pasar por el sistema para spamear a otro alumno.

    function notifCamposValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(
             ['destinatarioId', 'paraRol', 'tipo', 'titulo', 'mensaje', 'enlace', 'actorId', 'leida', 'creadoEn'])
        && d.keys().hasAll(['tipo', 'titulo', 'mensaje', 'actorId', 'leida', 'creadoEn'])
        && d.tipo in [
             'plan_aprobado', 'plan_rechazado', 'comprobante_subido',
             'clase_solicitada', 'clase_aceptada', 'clase_rechazada', 'clase_cancelada'
           ]
        && validString('titulo', 120) && d.titulo.size() > 0
        && validString('mensaje', 500)
        && d.leida == false
        && d.creadoEn is number
        && d.actorId == request.auth.uid
        && (!('enlace' in d) || d.enlace == null || (d.enlace is string && d.enlace.size() <= 200))
        && (!('destinatarioId' in d) || d.destinatarioId == null || d.destinatarioId is string)
        && (!('paraRol' in d) || d.paraRol == null || d.paraRol == 'admin');
    }

    match /notificaciones/{notifId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.destinatarioId == request.auth.uid);

      allow create: if notifCamposValidos()
        && (
          // Admin → alumno puntual (aprobar el plan desde el cliente).
          (isAdmin()
            && 'destinatarioId' in request.resource.data
            && request.resource.data.destinatarioId is string
            && !('paraRol' in request.resource.data && request.resource.data.paraRol != null))
          // Estudiante → grupo admin, solo al subir comprobante.
          || (isEstudiante()
              && request.resource.data.get('paraRol', null) == 'admin'
              && !('destinatarioId' in request.resource.data && request.resource.data.destinatarioId != null)
              && request.resource.data.tipo == 'comprobante_subido')
        );

      // Solo marcar como leída — el dueño de un aviso puntual, o
      // cualquier admin para los avisos de grupo (paraRol=='admin').
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.destinatarioId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
        && request.resource.data.leida == true;

      allow delete: if isAdmin();
    }
  }
}
