rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── comprobantes ─────────────────────────────────────────
    // El dueño sube su comprobante; cualquier usuario autenticado puede
    // leer (la URL de descarga incluye uid + transaccionId, no es adivinable).
    match /comprobantes/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ── fotos de perfil ────────────────────────────────────────
    // El dueño sube/reemplaza su propia foto (ya comprimida en el
    // cliente antes de llegar aquí). Cualquier autenticado puede verla
    // (avatares en rosters/mensajería). Tope generoso por si algún
    // navegador no soporta la compresión y sube el original.
    match /perfiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

  }
}
